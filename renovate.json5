{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  timezone: 'Asia/Tokyo',
  schedule: [
    'before 4am on Monday',
  ],
  'github-actions': {
    enabled: true
  },
  pub: {
    enabled: true
  },
  fvm: {
    enabled: true
  },
  packageRules: [
    {
      groupName: 'Flutter/Dart Packages',
      matchManagers: [
        'fvm',
        'pub',
      ],
      matchDepNames: [
        'flutter',
        'flutter_localizations',
        'flutter_test',
        'dart',
      ],
      enabled: true,
      versioning: 'semver',
    },
    {
      groupName: 'Firebase Packages',
      matchDepNames: [
        'cloud_firestore',
        'firebase_storage',
        'firebase_messaging',
        'firebase_remote_config',
        'firebase_crashlytics',
        'firebase_analytics',
        'firebase_auth',
        'firebase_core',
        'firebase_dynamic_links',
        'firebase_messaging',
      ],
    },
    {
      groupName: 'All minor and patch dependencies',
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      matchDepNames: [
        '!cloud_firestore',
        '!firebase_storage',
        '!firebase_messaging',
        '!firebase_remote_config',
        '!firebase_crashlytics',
        '!firebase_analytics',
        '!firebase_auth',
        '!firebase_core',
        '!firebase_dynamic_links',
        '!firebase_messaging',
        '!flutter',
        '!flutter_localizations',
        '!flutter_test',
        '!dart',
      ],
    },
  ],
  prHourlyLimit: 0,
  prConcurrentLimit: 0,
  labels: [
    'Type: Renovate',
  ],
  configMigration: true,
  dependencyDashboard: false,
}
